# Docker environment configuration for IMS

APP_NAME="Inventory Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=base64:k+OdYIMAJ6y/2vTA2G3MM6+e8Z1vZwxTWPIEOLRfh7Y=

# Database (SQLite)
DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite

# Or use PostgreSQL (uncomment postgres service in docker-compose.yml)
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=ims_db
# DB_USERNAME=ims_user
# DB_PASSWORD=secret123

# Cache
CACHE_DRIVER=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Redis (optional, for caching)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (optional)
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ims.local"
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Development/Testing
TELESCOPE_ENABLED=false
SANCTUM_STATEFUL_DOMAINS=localhost:8000

# Frontend configuration
VITE_API_URL=http://localhost/api
